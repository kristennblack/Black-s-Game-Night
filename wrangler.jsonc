{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "black-family-game-night",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_HUB",
        "class_name": "GameHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameHub"]
    }
  ]
}
