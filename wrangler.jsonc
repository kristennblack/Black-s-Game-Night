{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "black-family-game-night",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_HUB",
        "class_name": "GameHub"
      },
      {
        "name": "PROP_HUNT",
        "class_name": "PropHuntRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PropHuntRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
