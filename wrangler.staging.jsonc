{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "black-family-game-night-phase-p1-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./public","binding":"ASSETS","not_found_handling":"single-page-application"},
  "durable_objects": {"bindings":[
    {"name":"GAME_HUB","class_name":"GameHub"},
    {"name":"PROP_HUNT","class_name":"PropHuntRoom"},
    {"name":"ISLAND_LIFE","class_name":"IslandLifeRoom"}
  ]},
  "migrations": [
    {"tag":"v1","new_sqlite_classes":["GameHub"]},
    {"tag":"v2","new_sqlite_classes":["PropHuntRoom"]},
    {"tag":"v3","new_sqlite_classes":["IslandLifeRoom"]}
  ],
  "observability": {"enabled":true,"logs":{"head_sampling_rate":1},"traces":{"enabled":true,"head_sampling_rate":0.05}}
}
